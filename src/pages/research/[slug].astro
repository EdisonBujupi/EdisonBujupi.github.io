---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import WazuhContribution from '../../components/WazuhContribution.astro';
import { site } from '../../data/site';
import { allArticles, fmtDate, isoDate, categoryName, readingTime, related } from '../../lib';

export async function getStaticPaths() {
  const articles = await allArticles();
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: articles } }));
}
const { entry, all } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingTime(entry.body);
const path = `/research/${entry.id}/`;
const url = site.url + path;
const rel = related(entry, all);
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: d.title, description: d.description,
    datePublished: d.pubDate.toISOString(), dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: { '@type': 'Person', '@id': `${site.url}/#person`, name: site.author.name },
    publisher: { '@id': `${site.url}/#person` },
    mainEntityOfPage: url, inLanguage: 'en', keywords: d.tags.join(', '),
    articleSection: categoryName(d.category),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Research', item: site.url + '/research/' },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.title} description={d.description} path={path} type="article" published={d.pubDate} updated={d.updatedDate} jsonLd={jsonLd}>
  <div class="wrap page article-page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/research/">Research</a> / <span aria-current="page">{categoryName(d.category)}</span></nav>
    <header class="article-head">
      <p class="kicker"><a href={`/research/category/${d.category}/`}>{categoryName(d.category)}</a></p>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <p class="meta">
        <span>By {site.author.name}</span>{' · '}<time datetime={isoDate(d.pubDate)}>Published {fmtDate(d.pubDate)}</time>{d.updatedDate && <>{' · '}<time datetime={isoDate(d.updatedDate)}>Updated {fmtDate(d.updatedDate)}</time></>}{' · '}<span>{minutes} min read</span>
      </p>
      {d.repoUrl && <p class="meta"><a href={d.repoUrl} rel="noopener noreferrer" target="_blank">Repository for this article</a></p>}
    </header>
    <div class="article-grid">
      {toc.length >= 4 && (
        <nav class="toc" aria-label="Contents">
          <details open>
            <summary>Contents</summary>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text.replace(/^\d+\.\s*/, '')}</a></li>)}</ol>
          </details>
        </nav>
      )}
      <div class="prose"><Content /></div>
    </div>
    {d.wazuhContribution && <WazuhContribution />}
    {rel.length > 0 && (
      <section class="block" aria-labelledby="rel-h">
        <h2 id="rel-h" class="label">Related articles</h2>
        <div class="rows">{rel.map((a) => <ArticleRow entry={a} />)}</div>
      </section>
    )}
  </div>
</Base>
