---
import Base from '../../../layouts/Base.astro';
import ArticleRow from '../../../components/ArticleRow.astro';
import { categories, site } from '../../../data/site';
import { allArticles } from '../../../lib';
export async function getStaticPaths() {
  const articles = await allArticles();
  return categories
    .filter((c) => articles.some((a) => a.data.category === c.slug))
    .map((c) => ({ params: { slug: c.slug }, props: { cat: c, items: articles.filter((a) => a.data.category === c.slug) } }));
}
const { cat, items } = Astro.props;
const path = `/research/category/${cat.slug}/`;
const crumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Research', item: site.url + '/research/' },
    { '@type': 'ListItem', position: 3, name: cat.name, item: site.url + path },
  ],
};
---
<Base title={`${cat.name} articles`} description={`${cat.description} Articles in the ${cat.name} category.`} path={path} jsonLd={[crumbs]}>
  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/research/">Research</a> / <span aria-current="page">{cat.name}</span></nav>
    <h1>{cat.name}</h1>
    <p class="lede">{cat.description}</p>
    <div class="rows">{items.map((a) => <ArticleRow entry={a} showCategory={false} />)}</div>
  </div>
</Base>
