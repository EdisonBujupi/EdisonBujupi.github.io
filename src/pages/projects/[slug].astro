---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allProjects, fmtDate, isoDate } from '../../lib';
import { site } from '../../data/site';
export async function getStaticPaths() {
  const projects = await allProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const path = `/projects/${entry.id}/`;
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
  { '@type': 'ListItem', position: 2, name: 'Projects', item: site.url + '/projects/' },
  { '@type': 'ListItem', position: 3, name: d.title, item: site.url + path } ] };
---
<Base title={d.title} description={d.summary} path={path} jsonLd={[crumbs]}>
  <div class="wrap page article-page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/projects/">Projects</a> / <span aria-current="page">{d.title}</span></nav>
    <header class="article-head">
      <p class="kicker">{d.type} · {d.status}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <p class="meta"><time datetime={isoDate(d.date)}>{fmtDate(d.date)}</time>{' · '}<span>{d.tools.join(', ')}</span></p>
      {d.repoUrl && <p class="meta"><a href={d.repoUrl} rel="noopener noreferrer" target="_blank">Repository</a></p>}
    </header>
    <div class="article-grid"><div class="prose"><Content /></div></div>
  </div>
</Base>
