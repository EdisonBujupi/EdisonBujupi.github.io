---
import Base from '../layouts/Base.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { site, wazuhLinks } from '../data/site';
import { allArticles } from '../lib';
const articles = (await allArticles()).filter((a) => a.data.wazuhContribution);
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
  { '@type': 'ListItem', position: 2, name: 'Contributions', item: site.url + '/wazuh-ambassador/' } ] };
---
<Base title="Contributions" description="Contributions Edison Bujupi has written as a member of the Wazuh Ambassadors Program, published on this personal website. Not official Wazuh material." path="/wazuh-ambassador/" jsonLd={[crumbs]}>
  <div class="wrap page article-page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Contributions</span></nav>
    <h1>Contributions</h1>
    <p class="lede">Contributions I have written as a member of the Wazuh Ambassadors Program. This is my personal website and it is not official Wazuh material.</p>
    <section class="block" aria-labelledby="pubs-h">
      <h2 id="pubs-h" class="label">Contributions</h2>
      {articles.length > 0 ? <div class="rows">{articles.map((a) => <ArticleRow entry={a} />)}</div> : <p class="muted">No contributions are listed yet.</p>}
    </section>
    <div class="article-grid"><div class="prose">
      <h2>Official Wazuh resources</h2>
      <ul>
        <li><a href={wazuhLinks.home} rel="noopener noreferrer" target="_blank">Wazuh website</a></li>
        <li><a href={wazuhLinks.ambassadors} rel="noopener noreferrer" target="_blank">Wazuh Ambassadors Program</a></li>
        <li><a href="https://documentation.wazuh.com/current/index.html" rel="noopener noreferrer" target="_blank">Wazuh documentation</a></li>
      </ul>
      <h2>Independence</h2>
      <p>This website is owned and operated by me. It is not operated, endorsed or maintained by Wazuh, and the articles are not official Wazuh material.</p>
    </div></div>
  </div>
</Base>
