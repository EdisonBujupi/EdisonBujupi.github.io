---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const groups = [
  { title: 'Wazuh documentation', items: [
    { label: 'Custom rules (rule ID range 100000 to 120000)', url: 'https://documentation.wazuh.com/current/user-manual/ruleset/rules/custom.html', note: 'How to write and place your own rules, and which ID range is reserved for them.' },
    { label: 'Monitoring execution of malicious commands with auditd', url: 'https://documentation.wazuh.com/4.14/proof-of-concept-guide/audit-commands-run-by-user.html', note: 'The official guide that uses auditd with Wazuh.' },
    { label: 'Wazuh 5.0 RC documentation', url: 'https://documentation.wazuh.com/5.0-rc/index.html', note: 'Pre-release documentation. Do not use the release candidate in production.' },
    { label: 'Wazuh 5.0 RC: Findings', url: 'https://documentation.wazuh.com/5.0-rc/user-manual/data-analysis/findings.html', note: 'How findings replace alerts in the new detection engine.' },
  ]},
  { title: 'Technique references', items: [
    { label: 'MITRE ATT&CK T1059: Command and Scripting Interpreter', url: 'https://attack.mitre.org/techniques/T1059/', note: 'Covers shells and interpreters. Running one is not an attack by itself.' },
    { label: 'MITRE ATT&CK T1105: Ingress Tool Transfer', url: 'https://attack.mitre.org/techniques/T1105/', note: 'Covers bringing tools onto a system, for example with curl.' },
  ]},
];
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
  { '@type': 'ListItem', position: 2, name: 'Resources', item: site.url + '/resources/' } ] };
---
<Base title="Resources" description="Technical references used in my Wazuh and detection engineering work: official documentation and technique references." path="/resources/" jsonLd={[crumbs]}>
  <div class="wrap page article-page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Resources</span></nav>
    <h1>Resources</h1>
    <p class="lede">References I actually used while writing the articles. The list grows with the research.</p>
    <div class="article-grid"><div class="prose">
      {groups.map((g) => (
        <>
          <h2>{g.title}</h2>
          <ul>{g.items.map((i) => <li><a href={i.url} rel="noopener noreferrer" target="_blank">{i.label}</a>. {i.note}</li>)}</ul>
        </>
      ))}
    </div></div>
  </div>
</Base>
