---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, social } from '../data/site';
interface Props {
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  jsonLd?: object[];
}
const props = Astro.props;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.author.name,
  jobTitle: site.author.jobTitle,
  url: site.url,
  ...(site.author.image ? { image: new URL(site.author.image, site.url).href } : {}),
  sameAs: [social.github, social.linkedin].filter(Boolean),
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'en',
  publisher: { '@id': `${site.url}/#person` },
};
const ld = props.path === '/' ? [website, person, ...(props.jsonLd ?? [])] : (props.jsonLd ?? []);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/*
      Content Security Policy for a static site with no client-side scripts and no third-party assets.
      JSON-LD blocks are data, not executable scripts, so script-src 'self' does not block them.
      style-src needs 'unsafe-inline' for the inline styles that syntax highlighting adds to code blocks.
      Enabling analytics or any other third-party script or asset (see services in src/data/site.ts)
      requires adding its origin to this policy, and an inline script also needs a hash or nonce.
      frame-ancestors cannot be set in a meta tag. It needs an HTTP header, which GitHub Pages does not allow.
    */}
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; form-action 'self'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e0e0f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <Seo {...props} jsonLd={ld} />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
